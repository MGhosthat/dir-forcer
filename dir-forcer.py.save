import requests

# 1. Set your target URL and a small list of test words (wordlist)
target_url = "http://testphp.vulnweb.com"
wordlist = ["admin", "login", "cart", "images", "user", "secret", "dashboard"]

print(f"[*] Starting directory scan on: {target_url}\n")

# 2. Loop through each word in the list
for word in wordlist:
    # Build the full URL to test (e.g., http://target.com/admin)
    full_url = f"{target_url}/{word}"
    
    try:
        # 3. Send an HTTP GET request to the URL
        response = requests.get(full_url, timeout=3)
        
        # 4. Check if the page exists (Status code 200)
        if response.status_code == 200:
            print(f"[+] Discovered Directory: {full_url} (Status: 200)")
        elif response.status_code == 403:
            print(f"[!] Forbidden Directory: {full_url} (Status: 403)")
            
    except requests.exceptions.ConnectionError:
        # Handles errors if the server is offline or unreachable
        print(f"[-] Connection failed for: {full_url}")
    except requests.exceptions.Timeout:
        print(f"[-] Request timed out for: {full_url}")

print("\n[*] Scan complete!")
